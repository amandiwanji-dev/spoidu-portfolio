# Copy to `.env` (or set these in your hosting dashboard) and fill in what you use.

# Your live domain, no trailing slash. Used for canonical + Open Graph URLs.
VITE_SITE_URL=

# Contact form — set ONE of these. Both are public, browser-safe identifiers,
# not secret keys. Create the form at https://formspree.io or https://web3forms.com
VITE_FORMSPREE_ID=
VITE_WEB3FORMS_ACCESS_KEY=
